    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
