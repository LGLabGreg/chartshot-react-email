{
  "name": "chartshot-react-email-weekly-digest",
  "description": "A React Email weekly digest with charts drawn by Chartshot.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
